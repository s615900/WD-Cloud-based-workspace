modules = ["nodejs-24"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start", "--", "-p", "5000"]
healthCheckPath = "/api/healthz"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5055
externalPort = 3000

[[ports]]
localPort = 5056
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080
