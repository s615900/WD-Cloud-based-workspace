# ============================================================
# 環境變數範本：複製成 .env.local 後填入實際值
#   cp .env.example .env.local
# 【必填】沒填對應功能會失敗；【選填】可留空
# 值含特殊字元或換行時請用雙引號包起來
# 此檔會進 git，請勿填入真實密碼
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. 系統基本設定
# ────────────────────────────────────────────────────────────
# 【必填】登入 session cookie 與報價單／合約簽署連結 token 的簽章鑰匙。
# 請用長亂數字串；更換後所有人需重新登入、已寄出的簽署連結會失效。
SESSION_SECRET=
# 【必填】每日提醒排程 /api/cron/daily-reminder?key=… 的驗證密碼（外部排程服務如 cron-job.org 使用）。
CRON_SECRET=
# 【選填】本機開發用：設為 true 時略過 LINE 登入，直接進桌面版。
# 只在 npm run dev 有效，npm start（正式環境）會自動忽略。
AUTH_BYPASS=false

# ────────────────────────────────────────────────────────────
# 2. LINE Login（管理者登入桌面版）
# LINE Developers → LINE Login channel。跟下面的 LINE Bot 是不同的 channel。
# ────────────────────────────────────────────────────────────
# 【必填】LINE Login channel 的 Channel ID。
LINE_LOGIN_CHANNEL_ID=
# 【必填】LINE Login channel 的 Channel secret。
LINE_LOGIN_CHANNEL_SECRET=
# 【必填】唯一允許登入的 LINE User ID（U 開頭）。其他帳號登入會被導到「無權限」頁。
ALLOWED_LINE_USER_ID=
# 【選填】登入完成後的回呼網址，必須跟 LINE Developers 後台登記的 Callback URL 完全一致。
# 不設定時自動使用「目前網域 + /auth/callback」。
# LINE_LOGIN_REDIRECT_URI=https://你的網域/auth/callback

# ────────────────────────────────────────────────────────────
# 3. LINE Bot（Messaging API：webhook、推播）
# LINE Developers → Messaging API channel。Webhook URL 設為 https://你的網域/webhook
# ────────────────────────────────────────────────────────────
# 【必填】Messaging API channel 的 Channel secret（驗證 webhook 簽章）。
LINE_CHANNEL_SECRET=
# 【必填】Messaging API channel 的長期 Channel access token（回覆／推播訊息）。
LINE_CHANNEL_ACCESS_TOKEN=
# 【必填】接收推播的 LINE User ID（通常就是你自己，同 ALLOWED_LINE_USER_ID）。
# 待辦、行程也會用這個 ID 當作擁有者寫入 Ragic。
LINE_USER_ID=

# ────────────────────────────────────────────────────────────
# 4. Ragic 資料庫
# 三個 Ragic 表單群組共用同一把 API Key。
# ────────────────────────────────────────────────────────────
# 【必填】Ragic 個人設定 → API 金鑰。
RAGIC_API_KEY=
# 【必填】待辦事項表單網址（/ragicforms21/1）：LINE Bot 待辦、桌面版「待辦事項」頁。
RAGIC_BASE_URL=https://ap15.ragic.com/你的帳號/ragicforms21/1
# 【必填】行事曆資料夾網址（不含表單編號）：班別模板 /6、空檔設定 /7、排班行程 /8、空檔預約 /9。
RAGIC_FOLDER_BASE=https://ap15.ragic.com/你的帳號/ragicforms21
# 【必填】接案商業模組網址：客戶資料、產品、報價單、合約、專案進度。
QUOTATION_RAGIC_BASE_URL=https://ap15.ragic.com/你的帳號

# ────────────────────────────────────────────────────────────
# 5. Google 日曆（服務帳號）
# Google Cloud 服務帳號，並把目標日曆共用給服務帳號信箱（可編輯）。
# ────────────────────────────────────────────────────────────
# 【必填】服務帳號信箱（xxx@xxx.iam.gserviceaccount.com）。
GOOGLE_CLIENT_EMAIL=
# 【必填】服務帳號私鑰，整段用雙引號包起來，換行保留為 \n。
GOOGLE_PRIVATE_KEY=
# 【必填】要寫入行程的日曆 ID（日曆設定 → 整合日曆 → 日曆 ID）。
GOOGLE_CALENDAR_ID=

# ────────────────────────────────────────────────────────────
# 6. 合約簽署
# ────────────────────────────────────────────────────────────
# 【選填】合約「負責人簽署」記錄的簽署人（我們公司這一方）。沒填時預設為 weite.wu@qsprinttw.com。
CONTRACT_STAFF_EMAIL=

# ────────────────────────────────────────────────────────────
# 7. AI 輔助（選用）
# LINE Bot 文字自動分類、圖片辨識。預設關閉。
# ────────────────────────────────────────────────────────────
# 【選填】設為 true 才啟用 AI 功能。
AI_FEATURES_ENABLED=false
# 【選填】Google Gemini API 金鑰（AI_FEATURES_ENABLED=true 時才需要）。
GEMINI_API_KEY=
